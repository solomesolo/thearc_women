generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Raw scraped medical articles from external sources (PubMed, guidelines, etc.)
model RawMedicalArticle {
  id               String   @id @default(uuid()) @db.Uuid
  source           String
  sourceUrl        String
  title            String
  authors          String?
  journal          String?
  publicationDate  DateTime?
  abstract         String?
  fullText         String?
  keywords         String[] @default([]) // PostgreSQL text[]
  doi              String?
  scrapedAt        DateTime @default(now())
  processed        Boolean  @default(false)

  knowledgeArticles KnowledgeArticle[]

  @@map("raw_medical_articles")
}

/// Structured knowledge article derived from a raw medical article.
/// approvalStatus: "pending" = needs admin approval; "approved" = shown on blog.
model KnowledgeArticle {
  id                 String   @id @default(uuid()) @db.Uuid
  rawArticleId       String?  @db.Uuid
  rawArticle         RawMedicalArticle? @relation(fields: [rawArticleId], references: [id])

  title              String
  summary            String?
  keyFindings        String[] @default([])
  biologicalSystems  String[] @default([])
  symptoms           String[] @default([])
  biomarkers         String[] @default([])
  rootCauses         String[] @default([])
  preventiveTopics   String[] @default([])
  interventionTypes  String[] @default([])
  lifeStages         String[] @default([])
  evidenceLevel      String?
  approvalStatus     String?  @default("pending") // "pending" | "approved" — only approved shown on blog
  createdAt          DateTime @default(now())

  contents           KnowledgeContent[]
  labels             ArticleLabel[]

  @@map("knowledge_articles")
}

/// Rich narrative knowledge content attached to a knowledge article
model KnowledgeContent {
  id                   String   @id @default(uuid()) @db.Uuid
  articleId            String   @db.Uuid
  article              KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  scienceExplained     String?
  patternsAndRootCauses String?
  preventiveInsights   String?
  clinicalContext      String?
  qualityScore         Float?
  createdAt            DateTime @default(now())

  @@map("knowledge_content")
}

/// Flat label entries for flexible tagging and analytics
model ArticleLabel {
  id         String   @id @default(uuid()) @db.Uuid
  articleId  String   @db.Uuid
  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  labelType  String
  labelValue String
  createdAt  DateTime @default(now())

  @@map("article_labels")
}

/// Pipeline event log (scrape errors, LLM failures, JSON errors, duplicates, label failures)
model PipelineLog {
  id        String   @id @default(uuid()) @db.Uuid
  event     String   // e.g. scrape_error, llm_failure, json_parse_error, duplicate_article, label_mapping_failure
  message   String?
  payload   Json?    // optional context (article_id, error detail, etc.)
  createdAt DateTime @default(now())

  @@map("pipeline_logs")
}

/// Top-level article metadata (editorial or pipeline-generated)
model Article {
  id             Int              @id @default(autoincrement())
  slug           String           @unique
  title          String
  excerpt        String
  pillar         String?
  category       String?
  evidenceLevel  String?
  studyTypes     String?          // e.g. observational, randomized (comma or JSON)
  consensusStatus String?
  coverImageUrl  String?
  lensMapping    String[]        @default([])  // tag slugs or IDs for "lens"
  isPublished    Boolean          @default(false)
  isArchived     Boolean          @default(false)
  publishedAt    DateTime?
  readingTimeMinutes Int?         // computed on save/publish from sections + excerpt
  /// When set, article was generated by the pipeline (scraper + LLM); admin approves by publishing
  rawArticleId   String?          @db.Uuid

  sections        ArticleSection[]
  sources         ArticleSource[]
  tagJoins        ArticleTagJoin[]
  savedBy         SavedArticle[]
  views           ArticleView[]
  collectionJoins CollectionArticle[]
  planItems       PlanItem[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// Individual structured sections (1–9) for an article. 8 = Action protocol, 9 = Tracking framework.
model ArticleSection {
  id        Int      @id @default(autoincrement())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  /// 1–9 position in the article (6–9 gated: 6–7 legacy, 8 Action protocol, 9 Tracking framework)
  sectionIndex Int
  /// Optional label for the section in the UI
  title        String?
  /// Markdown / rich text content
  body         String

  /// Sections 6–9 gated by default in product experience
  isGated      Boolean @default(false)
  /// Preview text for gated sections (required when isGated)
  preview      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, sectionIndex])
}

/// Source / citation for an article (e.g., paper, guideline)
model ArticleSource {
  id        Int      @id @default(autoincrement())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  label        String  // short label e.g. Lancet 2024 study
  url          String?
  evidenceNote String? // optional context on strength / limitations

  createdAt DateTime @default(now())
}

/// Taxonomy types used for filtering
enum TaxonomyType {
  lifeStage
  symptom
  bodySystem
  preventiveFocus
  trending
  biomarker
  hormone
  goal
  rootCause
  interventionType
  evidenceLevel
  contentAccess
}

/// A single taxonomy tag (e.g., \"Perimenopause\", \"Cortisol\", \"Sleep disruption\")
model TaxonomyTag {
  id    Int          @id @default(autoincrement())
  slug  String       @unique
  label String
  type  TaxonomyType

  articleJoins ArticleTagJoin[]
}

/// Join table between Article and TaxonomyTag
model ArticleTagJoin {
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  tag       TaxonomyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     Int

  @@id([articleId, tagId])
  @@index([tagId])
}

/// MVP: subscription status by email (no full User table required for credentials auth)
model Subscriber {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
}

/// Health survey + personalization profile (linked by email from session)
model UserProfile {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  lifeStage      String?
  cyclePattern   String?
  goals          String[] @default([])  // PostgreSQL text[]
  symptoms       String[] @default([])
  riskFactors    String[] @default([])
  trainingVolume String?
  stressLevel    String?
  generatedTags   String[] @default([])  // rule-based from above
  surveyResponses Json?                  // full Arc intake variable_id -> value
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── User Features ────────────────────────────────────────────────────────────

/// Article saved by a user (email-keyed, no User table)
model SavedArticle {
  id        Int      @id @default(autoincrement())
  email     String
  articleId Int      @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@unique([email, articleId])
  @@index([email])
  @@map("saved_articles")
}

/// Article view event for recently-viewed tracking (append-only)
model ArticleView {
  id        Int      @id @default(autoincrement())
  email     String
  articleId Int      @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@index([email])
  @@map("article_views")
}

/// User-created collection of articles
model Collection {
  id        Int                 @id @default(autoincrement())
  email     String
  name      String
  colorKey  String              @default("stone") @map("color_key")
  createdAt DateTime            @default(now()) @map("created_at")
  articles  CollectionArticle[]

  @@index([email])
  @@map("collections")
}

/// Join table: articles inside a collection
model CollectionArticle {
  collectionId Int @map("collection_id")
  articleId    Int @map("article_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([collectionId, articleId])
  @@map("collection_articles")
}

/// User health plan
model HealthPlan {
  id         Int        @id @default(autoincrement())
  email      String
  name       String
  status     String     @default("active")   // active | paused | completed
  sourceType String?    @map("source_type") // protocol | articles | manual
  createdAt  DateTime   @default(now()) @map("created_at")
  items      PlanItem[]
  logs       ActionLog[]

  @@index([email])
  @@map("health_plans")
}

/// Individual item inside a health plan
model PlanItem {
  id          Int        @id @default(autoincrement())
  planId      Int        @map("plan_id")
  plan        HealthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  description String?
  timing      String     @default("anytime") // morning | evening | weekly | anytime
  sortOrder   Int        @default(0) @map("sort_order")
  isDone      Boolean    @default(false) @map("is_done")
  articleId   Int?       @map("article_id")
  article     Article?   @relation(fields: [articleId], references: [id], onDelete: SetNull)
  logs        ActionLog[]

  @@map("plan_items")
}

/// Action execution log entry
model ActionLog {
  id       Int         @id @default(autoincrement())
  email    String
  planId   Int?        @map("plan_id")
  plan     HealthPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  itemId   Int?        @map("item_id")
  item     PlanItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  note     String?
  loggedAt DateTime    @default(now()) @map("logged_at")

  @@index([email])
  @@map("action_logs")
}

/// In-app notification for a user
model UserNotification {
  id        Int      @id @default(autoincrement())
  email     String
  type      String   @default("system_reminder") // action_critical | knowledge_update | system_reminder
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  actionUrl String?  @map("action_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("user_notifications")
}

/// Health document uploaded by a user (PDF / image)
model HealthUpload {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @unique @default(uuid()) @db.Uuid @map("document_id")
  userEmail        String   @map("user_email")
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  fileSize         BigInt   @map("file_size")
  storagePath      String   @map("storage_path")
  uploadTimestamp  DateTime @default(now()) @map("upload_timestamp")
  processingStatus String   @default("pending") @map("processing_status") // pending | queued | processing | completed | failed
  pageCount        Int?     @map("page_count")
  ocrJob              OcrJob?
  ocrResult           OcrResult?
  classification      DocumentClassification?
  extraction          MedicalExtraction?
  binAssignment       BinAssignment?
  sensitivityProfile  SensitivityProfile?
  accessLogs          DocumentAccessLog[]
  normalizedResult    NormalizedResult?
  healthObservations  HealthObservation[]
  imagingRecord       ImagingRecord?
  clinicalNoteRecord  ClinicalNoteRecord?
  pipelineStepLogs    PipelineStepLog[]

  @@index([userEmail])
  @@map("health_uploads")
}

/// Clinical note record (one per document) for everything outside lab + imaging:
/// consult notes, procedure summaries, screening letters, medication summaries, etc.
model ClinicalNoteRecord {
  id              String      @id @default(uuid()) @db.Uuid
  documentId      String      @unique @map("document_id") @db.Uuid
  upload          HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  userEmail       String      @map("user_email")
  reportDate      DateTime?   @map("report_date") @db.Date
  documentType    String      @map("document_type") // from document_classifications.document_type

  summary         String?     // short summary / key note
  diagnoses       String[]    @default([])
  recommendations String?     // plan / follow-up / next steps
  medications     Json        @default("[]") @map("medications") // [{name,dose,units,frequency,route}]
  rawNotes        String?     @map("raw_notes") // fallback narrative / combined notes

  source          String      @default("extraction") // extraction | heuristic
  parsingWarnings String[]    @default([]) @map("parsing_warnings")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([userEmail, reportDate])
  @@map("clinical_notes_records")
}

/// Imaging report record (one per document when document_type=imaging_report)
/// Stores narrative sections (findings/impression/recommendations) for the user's health record.
model ImagingRecord {
  id              String      @id @default(uuid()) @db.Uuid
  documentId      String      @unique @map("document_id") @db.Uuid
  upload          HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  userEmail       String      @map("user_email")
  reportDate      DateTime?   @map("report_date") @db.Date
  modality        String?     // e.g. MRI, CT, X-ray, Ultrasound (best-effort)
  bodyPart        String?     @map("body_part")  // best-effort

  findings        String?     // narrative findings (Befund / Findings)
  impression      String?     // impression / diagnosis (Beurteilung / Impression)
  recommendations String?     // recommendations / follow-up (Empfehlung / Recommendation)

  diagnoses       String[]    @default([])       // extracted diagnosis strings (best-effort)
  source          String      @default("extraction") // extraction | heuristic
  parsingWarnings String[]    @default([]) @map("parsing_warnings")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([userEmail, reportDate])
  @@map("imaging_records")
}

/// OCR processing job created for each uploaded document
model OcrJob {
  id             String       @id @default(uuid()) @db.Uuid
  documentId     String       @unique @map("document_id") @db.Uuid
  upload         HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  status         String       @default("queued") // queued | processing | completed | failed
  currentStep    String?      @map("current_step") // ocr | classify | extract | bin_map | normalize | longitudinal | interventions
  completedSteps String[]     @default([]) @map("completed_steps")
  retryCount     Int          @default(0) @map("retry_count")
  maxRetries     Int          @default(2) @map("max_retries")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  error          String?

  @@map("ocr_jobs")
}

/// Per-step execution record for the processing pipeline
/// One row per attempt — retries produce additional rows with attempt > 1
model PipelineStepLog {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  upload       HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  step         String                        // ocr | classify | extract | bin_map | normalize | longitudinal | interventions
  status       String                        // started | completed | failed | retrying | skipped
  attempt      Int       @default(1)
  durationMs   Int?      @map("duration_ms")
  errorMessage String?   @map("error_message")
  errorDetail  String?   @map("error_detail")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  @@index([documentId])
  @@index([documentId, step])
  @@map("pipeline_step_logs")
}

/// Aggregated OCR result for a document (one per document)
model OcrResult {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @unique @map("document_id") @db.Uuid
  upload        HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  ocrStatus     String    @map("ocr_status")       // success | partial | failed
  rawText       String    @default("") @map("raw_text")
  pageCount     Int       @default(0) @map("page_count")
  avgConfidence Float     @default(0) @map("avg_confidence")  // 0–100
  processedAt   DateTime  @default(now()) @map("processed_at")
  pages         OcrPage[]

  @@map("ocr_results")
}

/// Per-page OCR output
model OcrPage {
  id          Int       @id @default(autoincrement())
  resultId    String    @map("result_id") @db.Uuid
  result      OcrResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  pageNumber  Int       @map("page_number")
  rawText     String    @default("") @map("raw_text")
  confidence  Float     @default(0)   // 0–100
  wordCount   Int       @default(0) @map("word_count")
  isLowConf   Boolean   @default(false) @map("is_low_conf")  // confidence < 50
  blocks      Json      @default("[]")  // [{block_num, text, conf, left, top, width, height}]

  @@index([resultId])
  @@map("ocr_pages")
}

/// Health category bin assignment (one per document, auto-created after extraction)
model BinAssignment {
  id                      String   @id @default(uuid()) @db.Uuid
  documentId              String   @unique @map("document_id") @db.Uuid
  upload                  HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  assignedBins            String[] @default([]) @map("assigned_bins")   // e.g. ["general_labs","cardiovascular"]
  entityBinMap            Json     @default("[]") @map("entity_bin_map") // per-entity mapping array
  classificationConfidence Float   @default(0) @map("classification_confidence") // 0.0–1.0
  methodSummary           Json     @default("{}") @map("method_summary") // {rule: N, model: N, ...}
  assignedAt              DateTime @default(now()) @map("assigned_at")

  @@map("bin_assignments")
}

/// Structured medical entity extraction result (one per document, auto-created after OCR)
model MedicalExtraction {
  id                   String   @id @default(uuid()) @db.Uuid
  documentId           String   @unique @map("document_id") @db.Uuid
  upload               HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  structuredEntities   Json     @default("[]") @map("structured_entities")  // array of entity objects
  extractionConfidence Float    @default(0) @map("extraction_confidence")   // 0.0–1.0
  missingFields        String[] @default([]) @map("missing_fields")
  parsingWarnings      String[] @default([]) @map("parsing_warnings")
  extractedAt          DateTime @default(now()) @map("extracted_at")

  @@map("medical_extractions")
}

/// Document type classification result (one per document, auto-created after OCR)
model DocumentClassification {
  id                     String   @id @default(uuid()) @db.Uuid
  documentId             String   @unique @map("document_id") @db.Uuid
  upload                 HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  documentType           String   @map("document_type")        // primary type
  secondaryDocumentTypes String[] @default([]) @map("secondary_document_types")
  confidence             Float    @default(0) @map("confidence") // 0.0–1.0
  allScores              Json     @default("{}") @map("all_scores")  // {type: score} for all types
  classifiedAt           DateTime @default(now()) @map("classified_at")

  @@map("document_classifications")
}

/// Sensitivity profile computed from bin assignment (one per document)
model SensitivityProfile {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @unique @map("document_id") @db.Uuid
  upload           HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  sensitivityLevel String   @map("sensitivity_level")   // standard | sensitive | high_sensitivity
  privacyTags      String[] @default([]) @map("privacy_tags")
  flaggedBins      String[] @default([]) @map("flagged_bins")
  tagReasons       Json     @default("{}") @map("tag_reasons")  // {bin: reason}
  taggedAt         DateTime @default(now()) @map("tagged_at")

  @@map("sensitivity_profiles")
}

/// Audit log — every access to a sensitive or high-sensitivity document's content
model DocumentAccessLog {
  id               Int      @id @default(autoincrement())
  documentId       String   @map("document_id") @db.Uuid
  upload           HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  userEmail        String   @map("user_email")
  route            String                      // e.g. "/api/ocr/{id}/extract"
  action           String   @default("read")  // read | export | re_run
  sensitivityLevel String   @map("sensitivity_level")
  accessedAt       DateTime @default(now()) @map("accessed_at")

  @@index([documentId])
  @@index([userEmail])
  @@index([accessedAt])
  @@map("document_access_logs")
}

/// Care gap and intervention flag — one row per (user_email, canonical_metric_name)
/// Regenerated by intervention_planner.py each time a document is processed.
model CareGapFlag {
  id                    String    @id @default(uuid()) @db.Uuid
  userEmail             String    @map("user_email")
  canonicalMetricName   String    @map("canonical_metric_name")
  category              String
  label                 String
  gapStatus             String    @map("gap_status")           // never_recorded | overdue | due_soon | current
  priority              String    @default("routine")          // routine | surveillance | urgent
  lastObservedDate      DateTime? @map("last_observed_date") @db.Date
  expectedIntervalDays  Int       @map("expected_interval_days")
  nextExpectedDate      DateTime? @map("next_expected_date") @db.Date
  daysOverdue           Int?      @map("days_overdue")
  daysUntilDue          Int?      @map("days_until_due")
  suggestedAction       String    @map("suggested_action")
  guidelineSource       String    @default("") @map("guideline_source")
  computedAt            DateTime  @default(now()) @map("computed_at")

  @@unique([userEmail, canonicalMetricName], name: "care_gap_flags_user_metric_key")
  @@index([userEmail])
  @@index([userEmail, gapStatus, priority])
  @@index([userEmail, category])
  @@map("care_gap_flags")
}

/// Longitudinal health observation — one row per (document_id, observation_id)
/// observation_id is a 32-char SHA-256 prefix produced by normalizer.py
model HealthObservation {
  id                  String   @id @default(uuid()) @db.Uuid
  observationId       String   @map("observation_id")          // 32-char hash
  documentId          String   @map("document_id") @db.Uuid
  upload              HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  userEmail           String   @map("user_email")
  bin                 String                                    // primary health bin slug
  observationDate     DateTime? @map("observation_date") @db.Date
  metricName          String?  @map("metric_name")
  canonicalMetricName String?  @map("canonical_metric_name")
  displayName         String?  @map("display_name")
  category            String   @default("other")
  valueText           String?  @map("value_text")
  numericValue        Float?   @map("numeric_value")
  unit                String?
  originalUnit        String?  @map("original_unit")
  referenceRange      String?  @map("reference_range")
  flag                String?                                   // H | L | HH | LL
  interpretation      String?
  confidenceScore     Float    @default(0.5) @map("confidence_score")
  sensitivityLevel    String   @default("standard") @map("sensitivity_level")
  sensitivityFlag     Boolean  @default(false) @map("sensitivity_flag")
  privacyTags         String[] @default([]) @map("privacy_tags")
  sourceEntityIndex   Int?     @map("source_entity_index")
  conversionApplied   Boolean  @default(false) @map("conversion_applied")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([documentId, observationId], name: "health_observations_doc_obs_key")
  @@index([userEmail, canonicalMetricName, observationDate])
  @@index([userEmail, bin])
  @@index([userEmail, sensitivityLevel])
  @@index([observationDate])
  @@map("health_observations")
}

/// Normalised observation set — canonical test names, units, and values (one per document)
model NormalizedResult {
  id                     String   @id @default(uuid()) @db.Uuid
  documentId             String   @unique @map("document_id") @db.Uuid
  upload                 HealthUpload @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  normalizedObservations Json     @default("[]") @map("normalized_observations")
  totalObservations      Int      @default(0) @map("total_observations")
  activeObservations     Int      @default(0) @map("active_observations")
  supersededCount        Int      @default(0) @map("superseded_count")
  conversionCount        Int      @default(0) @map("conversion_count")
  missingCanonical       Int      @default(0) @map("missing_canonical")
  normalizedAt           DateTime @default(now()) @map("normalized_at")

  @@map("normalized_results")
}

