# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# iCloud/Dropbox-style duplicate tree — breaks Next.js dev bundling if it sits in the repo root
/node_modules.nosync
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# webpack dev cache (redirected out of `.next` — see next.config.ts)
/.webpack-cache/
/.next-webpack-cache/

# python
**/__pycache__/
*.pyc

# one-off migration helpers (local only)
run_migration_tmp.*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local artefacts
*.tgz
cookies.txt
.audit-build.log
.claude/
